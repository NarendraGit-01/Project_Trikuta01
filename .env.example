# Application Configuration
APP_NAME="Trikuta Temple Receipt OCR & Management System"
APP_ENV="development"
DEBUG=true

# Security & Authentication
SECRET_KEY="replace-this-with-a-secure-random-secret-key-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database
DATABASE_URL="sqlite:///./temple_receipts.db"

# Storage
STORAGE_DIR="./data/storage"

# Supabase (Optional: For PostgreSQL Database & Cloud Image Storage)
# DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"
# SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
# SUPABASE_KEY="[YOUR-SUPABASE-SERVICE-ROLE-KEY-OR-ANON-KEY]"
# SUPABASE_BUCKET="receipts"



GEMINI_PRIMARY_MODEL="gemini-3.5-flash"
GEMINI_FALLBACK_MODEL="gemini-2.5-flash"
GEMINI_ROUTING_MODEL="gemini-2.5-flash-lite"

# Temple Configuration
TEMPLE_NAME_TE="శ్రీ త్రికోటేశ్వర స్వామి వారి దేవస్థానము"
TEMPLE_NAME_EN="Sri Trikoteswara Swamy Vari Devasthanam"
TEMPLE_LOCATION="Kotappakonda"

# Receipt Uniqueness Policy: "global" | "yearly" | "none"
RECEIPT_UNIQUENESS_POLICY="yearly"

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:5173","*"]
